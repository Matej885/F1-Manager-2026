<Window x:Class="F1_Manager_2026.Calendar"

xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

xmlns:local="clr-namespace:F1_Manager_2026"

Title="RACE CALENDAR 2026"

WindowState="Maximized"

WindowStyle="None"

AllowsTransparency="True"

Background="#050505"

Icon="/Images/Program_icon.ico">



    <Window.DataContext>

        <Binding Source="{x:Static local:Database.Instance}"/>

    </Window.DataContext>



    <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <Border Grid.Row="0" Background="#FF0000" Height="60" Margin="0,0,0,30">

            <TextBlock Text="S E A S O N C A L E N D A R - 2 0 2 6"

Foreground="White" FontWeight="Black"

VerticalAlignment="Center" HorizontalAlignment="Center"

FontSize="24" />

        </Border>



        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="1.8*"/>

                <ColumnDefinition Width="1.2*"/>

            </Grid.ColumnDefinitions>



            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Hidden" Margin="0,0,20,0">

                <ItemsControl ItemsSource="{Binding Calendar2026}">

                    <ItemsControl.ItemsPanel>

                        <ItemsPanelTemplate>

                            <UniformGrid Columns="3"/>

                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Button x:Name="TrackBtn" Margin="8" Height="100" Background="#111111" BorderBrush="#333333" BorderThickness="2" Cursor="Hand" Click="Track_Click">

                                <Button.Template>

                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}"

BorderBrush="{TemplateBinding BorderBrush}"

BorderThickness="{TemplateBinding BorderThickness}">

                                            <Grid>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0">

                                                    <TextBlock Text="{Binding Round, StringFormat={}{0:00}}" Foreground="#FF0000" FontSize="32" FontWeight="Black" Margin="0,0,20,0"/>

                                                    <StackPanel VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding CountryCode}" Foreground="White" FontSize="20" FontWeight="Bold"/>

                                                        <TextBlock Text="{Binding Name}" Foreground="#666666" FontSize="11" FontWeight="SemiBold"/>

                                                    </StackPanel>

                                                </StackPanel>



                                                <Image x:Name="DoneCheck" Source="/Images/DoneRace.png" Width="25" Height="25"

HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Visibility="Collapsed"/>

                                            </Grid>

                                        </Border>

                                    </ControlTemplate>

                                </Button.Template>

                            </Button>

                            <DataTemplate.Triggers>

                                <DataTrigger Binding="{Binding IsDone}" Value="True">

                                    <Setter TargetName="TrackBtn" Property="BorderBrush" Value="#4CAF50"/>

                                    <Setter TargetName="TrackBtn" Property="Background" Value="#0A150A"/>

                                    <Setter TargetName="TrackBtn" Property="Opacity" Value="0.8"/>

                                </DataTrigger>

                            </DataTemplate.Triggers>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>



            <Border Grid.Column="1" Background="#0A0A0A" BorderBrush="#FF0000" BorderThickness="2,0,0,0" Padding="50,40">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>



                    <StackPanel Grid.Row="0" DataContext="{Binding SelectedTrack}">

                        <TextBlock Text="SELECTED CIRCUIT" Foreground="#FF0000" FontWeight="Bold" FontSize="13" Margin="0,0,0,20"/>



                        <Border Height="280" Background="White" CornerRadius="5" BorderBrush="#222222" BorderThickness="1" Margin="0,0,0,30">

                            <Grid>

                                <Image Source="{Binding ImagePath}" Stretch="Uniform" Margin="15" RenderOptions.BitmapScalingMode="HighQuality"/>



                                <Border x:Name="DoneOverlay" Background="#AA000000" Visibility="Collapsed">

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                        <Image Source="/Images/donerace.png" Width="80" Height="80"/>

                                        <TextBlock Text="COMPLETED" Foreground="White" FontWeight="Black" FontSize="24" Margin="0,10,0,0"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                        </Border>



                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="34" FontWeight="Black" TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding CircuitName}" Foreground="#FF0000" FontSize="16" FontWeight="Bold" Margin="0,8,0,40"/>



                        <UniformGrid Columns="2">

                            <StackPanel Margin="0,15">

                                <TextBlock Text="LAPS" Foreground="#444" FontSize="12" FontWeight="Bold"/>

                                <TextBlock Text="{Binding Laps}" Foreground="White" FontSize="28" FontWeight="Bold"/>

                            </StackPanel>

                            <StackPanel Margin="0,15">

                                <TextBlock Text="DISTANCE" Foreground="#444" FontSize="12" FontWeight="Bold"/>

                                <TextBlock Text="{Binding RaceDistance}" Foreground="White" FontSize="22" FontWeight="Bold"/>

                            </StackPanel>

                        </UniformGrid>

                    </StackPanel>



                    <StackPanel Grid.Row="1" Margin="0,40,0,0">

                        <Button Content="BACK TO MAIN MENU" Height="60" Background="#111" Foreground="White"

FontWeight="Bold" FontSize="16" BorderBrush="#333" Cursor="Hand" Click="Button_Back_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>



    <Window.Style>

        <Style TargetType="Window">

            <Style.Triggers>

                <DataTrigger Binding="{Binding SelectedTrack.IsDone}" Value="True">

                </DataTrigger>

            </Style.Triggers>

        </Style>

    </Window.Style>
</Window>