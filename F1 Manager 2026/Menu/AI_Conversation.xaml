<Window x:Class="F1_Manager_2026.Menu.AI_Conversation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStyle="None"
        Title="AI Strategic Advisor" Height="1080" Width="1920"
        Background="#050505">

    <Window.Resources>
        <Style x:Key="F1ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E10600"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1E14"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0A0A0A" BorderBrush="Red" BorderThickness="0,0,0,4">
            <Grid Margin="60,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="8" Height="40" Fill="Red" Margin="0,0,15,0"/>
                    <TextBlock Text="STRATEGIC AI ADVISOR" Foreground="White" FontSize="36" FontWeight="Black" FontStyle="Italic" FontFamily="Bahnschrift"/>
                </StackPanel>
                <TextBlock Text="CONNECTED TO GROQ-LLAMA-3.3" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#444" FontSize="14" FontWeight="Bold"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="60,30,60,10" Background="#0A0A0A" BorderBrush="#222" BorderThickness="1">
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ChatItemsControl" Margin="20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,5,0,15" Padding="15" CornerRadius="5" 
                                    Background="{Binding BackgroundColor}" 
                                    HorizontalAlignment="{Binding Alignment}" 
                                    MaxWidth="1000">
                                <StackPanel>
                                    <TextBlock Text="{Binding Sender}" Foreground="Red" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Message}" Foreground="White" FontSize="16" TextWrapping="Wrap" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="60,0,60,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="UserInput" 
                     Background="#111" Foreground="White" 
                     BorderBrush="#333" BorderThickness="2" 
                     FontSize="18" Padding="15,20"
                     VerticalContentAlignment="Center"
                     KeyDown="UserInput_KeyDown"
                     Tag="Enter strategic inquiry..."/>

            <Button Grid.Column="1" Content="SEND REQUEST" 
                    Style="{StaticResource F1ButtonStyle}" 
                    Margin="10,0,0,0" Click="Send_Click"/>
        </Grid>

        <Button Content="RETURN TO HQ" Click="Back_Click" 
                VerticalAlignment="Top" HorizontalAlignment="Right" 
                Margin="0,115,60,0" Width="150" Height="35" 
                Background="Transparent" Foreground="#666" 
                BorderBrush="#444" BorderThickness="1" FontSize="12"/>
    </Grid>
</Window>