<Window x:Class="F1_Manager_2026.Menu.RaceHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Race History - Season 2026" Height="600" Width="900"
        Background="#1A1A1A" WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
         Icon="/Images/Program_icon.png">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Nadpis -->
            <RowDefinition Height="*"/>    <!-- Tabuľka -->
            <RowDefinition Height="Auto"/> <!-- Spodná lišta -->
        </Grid.RowDefinitions>

        <!-- Nadpis a Filtre -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="RACE HISTORY" FontSize="32" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            <Rectangle Width="2" Height="30" Fill="Red" Margin="20,0"/>
            <TextBlock Text="SEASON 2026" FontSize="18" Foreground="#AAAAAA" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Hlavná tabuľka výsledkov -->
        <DataGrid Grid.Row="1" x:Name="HistoryGrid" 
                  AutoGenerateColumns="False" 
                  Background="Transparent" 
                  RowBackground="#252525" 
                  AlternatingRowBackground="#2D2D2D"
                  Foreground="White" 
                  BorderThickness="0" 
                  GridLinesVisibility="None"
                  FontSize="14"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="HistoryGrid_SelectionChanged">
            
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="Red"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ROUND" Binding="{Binding RoundNumber}" Width="70"/>
                <DataGridTextColumn Header="GRAND PRIX" Binding="{Binding TrackName}" Width="*"/>
                <DataGridTextColumn Header="WINNER" Binding="{Binding WinnerName}" Width="*"/>
                
                <!-- Výsledky tvojich jazdcov -->
                <DataGridTemplateColumn Header="TEAM RESULT" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Driver1Pos, StringFormat='P{0}'}" Foreground="Gold" FontWeight="Bold"/>
                                <TextBlock Text=" / " Foreground="Gray"/>
                                <TextBlock Text="{Binding Driver2Pos, StringFormat='P{0}'}" Foreground="Silver"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="POINTS" Binding="{Binding TotalPoints}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalPoints}" Value="0">
                                    <Setter Property="Foreground" Value="Gray"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPodium}" Value="True">
                                    <Setter Property="Foreground" Value="LimeGreen"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Tlačidlo Späť -->
        <Button Grid.Row="2" Content="BACK TO MENU" 
                Width="200" Height="40" HorizontalAlignment="Left" Margin="0,20,0,0"
                Background="#333333" Foreground="White" FontWeight="Bold"
                Click="BackButton_Click"/>
    </Grid>
</Window>