<Window x:Class="F1_Manager_2026.Menu.RaceHistoryDetail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Race Result" Height="720" Width="1100"
        Background="#151515" WindowStartupLocation="CenterScreen"
        WindowState="Maximized" WindowStyle="None">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <TextBlock Text="{Binding TrackName}" FontSize="30" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            <Rectangle Width="2" Height="28" Fill="Red" Margin="18,0"/>
            <TextBlock Text="{Binding RoundNumber, StringFormat=ROUND {0}}" FontSize="18" Foreground="#B0B0B0" VerticalAlignment="Center"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,12,0" Background="#202020" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="WINNER" Foreground="#8C8C8C" FontSize="12"/>
                    <TextBlock Text="{Binding WinnerName}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding WinnerTeam}" Foreground="#D6D6D6" FontSize="14"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="0,0,12,0" Background="#202020" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="DRIVER 1" Foreground="#8C8C8C" FontSize="12"/>
                    <TextBlock Text="{Binding Driver1Pos, StringFormat=P{0}}" Foreground="Gold" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="0,0,12,0" Background="#202020" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="DRIVER 2" Foreground="#8C8C8C" FontSize="12"/>
                    <TextBlock Text="{Binding Driver2Pos, StringFormat=P{0}}" Foreground="Silver" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#202020" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="TEAM POINTS" Foreground="#8C8C8C" FontSize="12"/>
                    <TextBlock Text="{Binding TotalPoints}" Foreground="LimeGreen" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <DataGrid Grid.Row="2" x:Name="ResultsGrid"
                  AutoGenerateColumns="False"
                  Background="Transparent"
                  RowBackground="#252525"
                  AlternatingRowBackground="#2D2D2D"
                  Foreground="White"
                  BorderThickness="0"
                  GridLinesVisibility="None"
                  FontSize="14"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="Red"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="POS" Binding="{Binding Position}" Width="80"/>
                <DataGridTextColumn Header="DRIVER" Binding="{Binding DriverName}" Width="*"/>
                <DataGridTextColumn Header="TEAM" Binding="{Binding TeamName}" Width="*"/>
                <DataGridTextColumn Header="PTS" Binding="{Binding PointsEarned}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="3" Content="BACK TO HISTORY"
                Width="220" Height="42" HorizontalAlignment="Left" Margin="0,18,0,0"
                Background="#333333" Foreground="White" FontWeight="Bold"
                Click="BackButton_Click"/>
    </Grid>
</Window>